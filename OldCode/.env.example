PORT=5000

# MongoDB Atlas Connection String (leave empty to use Zero-DB fallback)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/caller-app?retryWrites=true&w=majority

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

JWT_SECRET=your_jwt_secret_key_here
PUBLIC_URL=https://your-ngrok-subdomain.ngrok-free.app
