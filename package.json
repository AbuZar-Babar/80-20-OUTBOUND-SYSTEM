{
  "name": "caller-app",
  "version": "1.0.0",
  "description": "Full-Stack Web Calling & SMS Application powered by Node.js, Express, and Twilio APIs",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon --watch backend backend/server.js"
  },
  "nodemonConfig": {
    "watch": [
      "backend"
    ],
    "ignore": [
      "data/*",
      "frontend/*",
      "scratch/*",
      "*.json"
    ]
  },
  "keywords": [
    "twilio",
    "voice",
    "sms",
    "express",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "twilio": "^5.2.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
